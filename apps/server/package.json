{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "db:migrate": "bun run ../../packages/db/src/migrate-cli.ts",
    "db:seed": "bun run src/seed.ts",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test:http": "test -n \"$DATABASE_URL\" || (echo 'DATABASE_URL must point to an isolated PostgreSQL database' >&2; exit 1); bun test test/http.test.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@onlyoffice/auth": "workspace:*",
    "@onlyoffice/db": "workspace:*",
    "@onlyoffice/env": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "fflate": "^0.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@onlyoffice/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
